{
  "name": "zuhause-mortgage-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:update": "node scripts/update-rates.mjs && node scripts/update-prices.mjs",
    "data:nrw": "node scripts/update-nrw.mjs",
    "design:lint": "node design/skills/design-taste-frontend/scripts/lint.mjs src --app",
    "design:inspect": "node design/skills/design-taste-frontend/scripts/inspect.mjs http://127.0.0.1:4180 --app",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
